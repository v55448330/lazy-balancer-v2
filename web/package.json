{
  "name": "lazy-balancer-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test \"tests/**/*.spec.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='tests/**' --test-coverage-lines=80 --test-coverage-branches=91 --test-coverage-functions=88 \"tests/**/*.spec.ts\"",
    "typecheck:src": "vue-tsc -p tsconfig.json --noEmit",
    "typecheck:test": "vue-tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json",
    "build:vite": "vite build",
    "build": "npm run test:coverage && npm run typecheck:src && npm run typecheck:test && npm run build:vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.19.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.4",
    "globe.gl": "^2.46.2",
    "pinia": "^4.0.3",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "vue": "^3.5.41",
    "vue-echarts": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/prismjs": "^1.26.6",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.10"
  }
}
